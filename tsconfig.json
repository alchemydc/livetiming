{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": { "@/*": ["./src/web/*"], "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "scripts", "test", "vite.config.ts"]
}
